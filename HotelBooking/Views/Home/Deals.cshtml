@{
    ViewData["Title"] = "Ưu Đãi & Khuyến Mãi Đặc Biệt";
}

<div class="container py-5 my-3">
    <!-- Header -->
    <div class="text-center mb-5">
        <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold mb-2"><i class="bi bi-tag-fill me-1"></i> ƯU ĐÃI NỔI BẬT</span>
        <h1 class="fw-extrabold text-dark display-5">Mã Giảm Giá & Gói Nghỉ Dưỡng Đặc Quyền</h1>
        <p class="text-muted lead">Tiết kiệm nhiều hơn với các chương trình khuyến mãi độc quyền chỉ có tại Luxury Hotel Booking.</p>
    </div>

    <!-- Deals Grid -->
    <div class="row g-4 mb-5">
        <!-- Deal 1 -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1540541338287-41700207dee6?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Summer Deal" style="height: 200px; object-fit: cover;" />
                <div class="card-body p-4 d-flex flex-column">
                    <span class="badge bg-primary align-self-start mb-2">Ưu đãi biển đảo</span>
                    <h5 class="fw-bold text-dark">Kỳ Nghỉ Phú Quốc - Giảm 20%</h5>
                    <p class="text-muted small">Áp dụng cho tất cả các resort 5 sao tại Bãi Khem & Bãi Dài khi đặt từ 2 đêm trở lên.</p>
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-dark border px-3 py-2 font-monospace fw-bold">SUMMERPQ20</span>
                        <a asp-controller="Hotel" asp-action="Index" asp-route-City="Phú Quốc" class="btn btn-sm btn-primary rounded-pill px-3">
                            Đặt Ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deal 2 -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Da Nang Deal" style="height: 200px; object-fit: cover;" />
                <div class="card-body p-4 d-flex flex-column">
                    <span class="badge bg-success align-self-start mb-2">Đà Nẵng Rực Rỡ</span>
                    <h5 class="fw-bold text-dark">Combo Đà Nẵng - Tặng Buffet Sáng</h5>
                    <p class="text-muted small">Miễn phí bữa sáng sang trọng cho 2 người cùng gói đưa đón sân bay 2 chiều miễn phí.</p>
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-dark border px-3 py-2 font-monospace fw-bold">DANANGFREE</span>
                        <a asp-controller="Hotel" asp-action="Index" asp-route-City="Đà Nẵng" class="btn btn-sm btn-success rounded-pill px-3">
                            Đặt Ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Deal 3 -->
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1584132967334-10e028bd69f7?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Sapa Deal" style="height: 200px; object-fit: cover;" />
                <div class="card-body p-4 d-flex flex-column">
                    <span class="badge bg-warning text-dark align-self-start mb-2">Mùa Mây Sapa</span>
                    <h5 class="fw-bold text-dark">Sapa Mộng Mơ - Giảm Đến 30%</h5>
                    <p class="text-muted small">Trải nghiệm khách sạn phong cách Pháp giữa lòng thị xã Sa Pa với mức giá ưu đãi chưa từng có.</p>
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-dark border px-3 py-2 font-monospace fw-bold">SAPACLOUDS</span>
                        <a asp-controller="Hotel" asp-action="Index" asp-route-City="Sapa" class="btn btn-sm btn-warning text-dark rounded-pill px-3 fw-bold">
                            Đặt Ngay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
