@{
    ViewData["Title"] = "Về Chúng Tôi - Luxury Hotel Booking";
}

<div class="container py-5 my-3">
    <!-- Header -->
    <div class="text-center mb-5">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-2">VỀ CHÚNG TÔI</span>
        <h1 class="fw-extrabold text-dark display-5">Khám Phá Sứ Mệnh Của Luxury Hotel Booking</h1>
        <p class="text-muted lead mx-auto" style="max-width: 700px;">
            Mang đến cho bạn những trải nghiệm nghỉ dưỡng 5 sao đỉnh cao với công nghệ đặt phòng tiện lợi, thông minh và giá tốt nhất.
        </p>
    </div>

    <!-- Story & Mission Grid -->
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80" alt="About Luxury Hotel" class="img-fluid rounded-4 shadow-lg" />
        </div>
        <div class="col-lg-6">
            <h3 class="fw-bold text-dark mb-3">Tầm Nhìn & Giá Trị Cốt Lõi</h3>
            <p class="text-muted">
                Được thành lập với khát vọng kết nối du khách với những khách sạn, khu nghỉ dưỡng cao cấp hàng đầu Việt Nam. Chúng tôi tin rằng mỗi chuyến đi không chỉ đơn thuần là di chuyển, mà là một hành trình tận hưởng cuộc sống và tạo nên những kỷ niệm vô giá.
            </p>
            <div class="row g-3 mt-2">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                        <i class="bi bi-patch-check-fill text-primary fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">100% Khách Sạn Chọn Lọc</h6>
                            <small class="text-muted">Đạt tiêu chuẩn 4-5 sao</small>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                        <i class="bi bi-shield-lock-fill text-success fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Thanh Toán An Toàn</h6>
                            <small class="text-muted">Bảo mật thông tin tối đa</small>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                        <i class="bi bi-clock-history text-warning fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Hỗ Trợ 24/7</h6>
                            <small class="text-muted">Phản hồi trong 5 phút</small>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                        <i class="bi bi-award-fill text-danger fs-3 me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Ưu Đãi Độc Quyền</h6>
                            <small class="text-muted">Tiết kiệm đến 30%</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
