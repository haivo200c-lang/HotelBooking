@model ErrorViewModel
@{
    ViewData["Title"] = "Thông Báo Lỗi";
}

<div class="container py-5 my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">
                <div class="mb-4">
                    <span class="display-1 text-warning"><i class="bi bi-exclamation-triangle-fill"></i></span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Đã Xảy Ra Lỗi</h2>
                <p class="text-muted mb-4">
                    Trang bạn đang tìm kiếm có thể không tồn tại, đã bị gỡ bỏ hoặc đã xảy ra sự cố trong quá trình xử lý yêu cầu.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="p-2 bg-light rounded-3 small text-muted font-monospace mb-4">
                        Mã yêu cầu (Request ID): <strong>@Model.RequestId</strong>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-house-door me-2"></i> Quay Về Trang Chủ
                    </a>
                    <a asp-controller="Hotel" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-bold">
                        <i class="bi bi-building me-2"></i> Danh Sách Khách Sạn
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
