@model List<HotelBooking.Models.Entities.Booking>
@{
    ViewData["Title"] = "Lịch Sử Đặt Phòng Của Tôi";
}

<div class="container py-5 my-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-decoration-none">Tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch sử đặt phòng</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-extrabold text-dark mb-1"><i class="bi bi-calendar2-check text-primary me-2"></i> Lịch Sử Đặt Phòng</h3>
            <p class="text-muted small mb-0">Quản lý toàn bộ danh sách các đơn đặt phòng của bạn tại Luxury Hotel Booking</p>
        </div>
        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold">@Model.Count Đơn đặt</span>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Mã Đơn</th>
                            <th>Khách Sạn & Phòng</th>
                            <th>Thời Gian Lưu Trú</th>
                            <th>Tổng Tiền</th>
                            <th>Thanh Toán</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold font-monospace text-primary">@item.BookingCode</span>
                                    <small class="d-block text-muted" style="font-size: 0.75rem;">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <strong class="text-dark d-block">@item.Hotel?.Name</strong>
                                    <small class="text-muted">@item.BookingDetails.FirstOrDefault()?.RoomName</small>
                                </td>
                                <td>
                                    <div class="small">
                                        <span><i class="bi bi-box-arrow-in-right text-success me-1"></i> @item.CheckInDate.ToString("dd/MM/yyyy")</span>
                                        <br />
                                        <span><i class="bi bi-box-arrow-right text-danger me-1"></i> @item.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                        <span class="badge bg-light text-dark border ms-1">@item.TotalNights đêm</span>
                                    </div>
                                </td>
                                <td>
                                    <strong class="text-danger fw-bold">@item.TotalAmount.ToString("N0") đ</strong>
                                </td>
                                <td>
                                    @if (item.Payment?.Status == "Completed")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i> Đã thanh toán (@item.Payment.PaymentMethod)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i> Chờ thanh toán
                                        </span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Confirmed":
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i> Đã Xác Nhận</span>
                                            break;
                                        case "Pending":
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i> Chờ Duyệt</span>
                                            break;
                                        case "CheckedIn":
                                            <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-door-open me-1"></i> Đã Nhận Phòng</span>
                                            break;
                                        case "CheckedOut":
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="bi bi-box-arrow-right me-1"></i> Đã Trả Phòng</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill"><i class="bi bi-patch-check me-1"></i> Hoàn Tất</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="bi bi-x-circle me-1"></i> Đã Hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (item.Status == "Pending" || item.Status == "Confirmed")
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#cancelModal_@item.Id">
                                                <i class="bi bi-x-lg"></i> Hủy
                                            </button>

                                            <!-- Modal Cancel Confirmation -->
                                            <div class="modal fade" id="cancelModal_@item.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 rounded-4 shadow">
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác Nhận Hủy Đơn</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start py-3">
                                                            <p class="text-dark mb-1">Bạn có chắc chắn muốn hủy đơn đặt phòng <strong>@item.BookingCode</strong> tại khách sạn <strong>@item.Hotel?.Name</strong>?</p>
                                                            <small class="text-muted">Hành động này sẽ giải phóng phòng cho khách hàng khác và cập nhật trạng thái đơn thành "Đã Hủy".</small>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                                                            <form asp-action="Cancel" method="post">
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Xác Nhận Hủy</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
            <div class="mb-3 text-muted">
                <i class="bi bi-receipt-cutoff display-1 text-primary opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark">Bạn Chưa Có Đơn Đặt Phòng Nào</h4>
            <p class="text-muted">Hãy khám phá các khách sạn 5 sao sang trọng và đặt phòng ngay hôm nay.</p>
            <div>
                <a asp-controller="Hotel" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                    Khám Phá Khách Sạn
                </a>
            </div>
        </div>
    }
</div>
