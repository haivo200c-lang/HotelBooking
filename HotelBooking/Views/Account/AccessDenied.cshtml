@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <span class="display-1 text-danger"><i class="bi bi-shield-x"></i></span>
                </div>
                <h2 class="fw-bold text-dark mb-2">Truy Cập Bị Từ Chối</h2>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có quyền truy cập vào trang này. Khu vực này chỉ dành cho Quản Trị Viên hoặc Nhân Viên có thẩm quyền.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-3 fw-bold">
                        <i class="bi bi-house-door me-2"></i> Quay Lại Trang Chủ
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Đăng Nhập Tài Khoản Khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
