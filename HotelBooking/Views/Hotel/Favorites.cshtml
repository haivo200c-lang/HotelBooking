@model List<HotelBooking.Models.Entities.Hotel>
@{
    ViewData["Title"] = "Khách Sạn Yêu Thích";
}

<div class="container py-5 my-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-decoration-none">Hồ sơ cá nhân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khách sạn yêu thích</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-extrabold text-dark mb-1"><i class="bi bi-heart-fill text-danger me-2"></i> Danh Sách Khách Sạn Đã Lưu</h3>
            <p class="text-muted small mb-0">Các khách sạn và resort bạn đã đánh dấu để chuẩn bị cho chuyến đi sắp tới</p>
        </div>
        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold">@Model.Count Khách sạn</span>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var hotel in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="hotel-card d-flex flex-column">
                        <div class="hotel-card-img-wrapper">
                            <img src="@hotel.MainImageUrl" class="hotel-card-img" alt="@hotel.Name" />
                            <span class="badge-featured"><i class="bi bi-geo-alt-fill me-1"></i> @hotel.City</span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="star-rating mb-1">
                                @for (int i = 0; i < hotel.StarRating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </div>
                            <h5 class="fw-bold text-dark mb-1 text-truncate" title="@hotel.Name">
                                <a asp-controller="Hotel" asp-action="Detail" asp-route-id="@hotel.Id" class="text-dark text-decoration-none">
                                    @hotel.Name
                                </a>
                            </h5>
                            <p class="text-muted small mb-3">@hotel.Address</p>

                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block">Giá từ</small>
                                    <span class="fs-5 fw-extrabold text-primary">@hotel.MinPrice.ToString("N0") đ</span>
                                </div>
                                <a asp-controller="Hotel" asp-action="Detail" asp-route-id="@hotel.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                    Xem & Đặt Phòng
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
            <div class="mb-3 text-muted">
                <i class="bi bi-heartbreak display-1 text-danger opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark">Chưa Có Khách Sạn Nào Được Lưu</h4>
            <p class="text-muted">Hãy bấm nút "Lưu Yêu Thích" khi xem thông tin khách sạn để lưu lại danh sách tại đây.</p>
            <div>
                <a asp-controller="Hotel" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                    Khám Phá Khách Sạn Ngay
                </a>
            </div>
        </div>
    }
</div>
