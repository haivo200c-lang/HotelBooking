@model HotelBooking.Models.ViewModels.HotelDetailViewModel
@{
    ViewData["Title"] = Model.Hotel.Name;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Hotel" asp-action="Index" class="text-decoration-none">Khách sạn</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Hotel.Name</li>
        </ol>
    </nav>

    <!-- Hotel Header & Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <div class="star-rating">
                    @for (int i = 0; i < Model.Hotel.StarRating; i++)
                    {
                        <i class="bi bi-star-fill"></i>
                    }
                </div>
                <span class="badge bg-warning text-dark fw-bold">Khách sạn 5 Sao</span>
            </div>
            <h2 class="fw-extrabold text-dark mb-1">@Model.Hotel.Name</h2>
            <p class="text-muted small mb-0">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Hotel.Address, <strong>@Model.Hotel.City, @Model.Hotel.Country</strong>
                <span class="mx-2">•</span>
                <i class="bi bi-telephone text-primary me-1"></i> @Model.Hotel.Phone
            </p>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <!-- Favorite Toggle Button -->
            <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" onclick="toggleFav(@Model.Hotel.Id)" id="favBtn">
                <i class="bi @(Model.IsFavorite ? "bi-heart-fill text-danger" : "bi-heart")" id="favIcon"></i>
                <span id="favText">@(Model.IsFavorite ? "Đã Lưu" : "Lưu Yêu Thích")</span>
            </button>
            <a href="#roomsSection" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-calendar-check me-1"></i> Chọn Phòng Ngay
            </a>
        </div>
    </div>

    <!-- Image Gallery Grid -->
    <div class="row g-3 mb-5">
        <div class="col-lg-8">
            <div class="rounded-4 overflow-hidden shadow-sm h-100" style="max-height: 440px;">
                <img src="@Model.Hotel.MainImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="@Model.Hotel.Name" />
            </div>
        </div>
        <div class="col-lg-4">
            <div class="row g-3 h-100">
                @if (Model.Hotel.Images.Any(img => !img.IsPrimary))
                {
                    @foreach (var img in Model.Hotel.Images.Where(img => !img.IsPrimary).Take(2))
                    {
                        <div class="col-12">
                            <div class="rounded-4 overflow-hidden shadow-sm" style="height: 212px;">
                                <img src="@img.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="@img.Caption" />
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="rounded-4 overflow-hidden shadow-sm" style="height: 212px;">
                            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=600&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Hotel Gallery 1" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="rounded-4 overflow-hidden shadow-sm" style="height: 212px;">
                            <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80" class="w-100 h-100" style="object-fit: cover;" alt="Hotel Gallery 2" />
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Details and Facilities Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <!-- Description -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i> Tổng Quan Khách Sạn</h4>
                <p class="text-muted leading-relaxed mb-0" style="font-size: 1.05rem;">
                    @Model.Hotel.Description
                </p>
            </div>

            <!-- Facilities -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h4 class="fw-bold text-dark mb-3"><i class="bi bi-grid-fill text-primary me-2"></i> Tiện Nghi & Dịch Vụ Nổi Bật</h4>
                <div class="row g-3">
                    @foreach (var ha in Model.Hotel.HotelAmenities)
                    {
                        <div class="col-md-4 col-6">
                            <div class="d-flex align-items-center p-2 rounded-3 bg-light">
                                <i class="bi @ha.Amenity?.Icon text-primary fs-5 me-2"></i>
                                <span class="small fw-semibold text-dark">@ha.Amenity?.Name</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Rating & Quick Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">Điểm Đánh Giá</h5>
                        <small class="text-muted">Dựa trên @Model.Hotel.TotalReviewCount nhận xét thực tế</small>
                    </div>
                    <span class="badge-rating fs-4 p-2 px-3">@Model.Hotel.AverageRating</span>
                </div>
                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>Độ sạch sẽ</span>
                        <span class="text-primary">9.6/10</span>
                    </div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>Thái độ phục vụ</span>
                        <span class="text-primary">9.8/10</span>
                    </div>
                    <div class="d-flex justify-content-between small fw-bold">
                        <span>Vị trí địa lý</span>
                        <span class="text-primary">9.5/10</span>
                    </div>
                </div>
                <p class="small text-muted mb-0"><i class="bi bi-shield-check text-success me-1"></i> Khách sạn đã được xác thực chất lượng cao cấp.</p>
            </div>
        </div>
    </div>

    <!-- Available Rooms Selection Section -->
    <div id="roomsSection" class="mb-5 pt-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider"><i class="bi bi-door-open-fill me-1"></i> Lựa Chọn Phòng Nghỉ</span>
                <h3 class="fw-extrabold text-dark tracking-tight mb-0">Các Hạng Phòng Đang Còn Trống</h3>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var room in Model.AvailableRooms)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="row g-0">
                            <div class="col-lg-4 col-md-5 position-relative">
                                <img src="@room.ImageUrl" class="h-100 w-100" style="object-fit: cover; min-height: 220px;" alt="@room.Name" />
                                <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill small">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> @room.AreaM2 m²
                                </span>
                            </div>
                            <div class="col-lg-8 col-md-7 p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold mb-1">@room.RoomType?.Name</span>
                                        <h4 class="fw-bold text-dark mb-1">@room.Name</h4>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i> Còn @room.AvailableQuantity phòng
                                    </span>
                                </div>

                                <p class="text-muted small mb-3">@room.Description</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-sm-6">
                                        <small class="text-muted d-block"><i class="bi bi-people-fill text-primary me-1"></i> Sức chứa: <strong>Tối đa @room.Capacity người</strong></small>
                                    </div>
                                    <div class="col-sm-6">
                                        <small class="text-muted d-block"><i class="bi bi-lamp-fill text-warning me-1"></i> Loại giường: <strong>@room.BedInfo</strong></small>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-1 mb-4">
                                    @foreach (var ra in room.RoomAmenities)
                                    {
                                        <span class="facility-pill">
                                            <i class="bi @ra.Amenity?.Icon text-primary"></i> @ra.Amenity?.Name
                                        </span>
                                    }
                                </div>

                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted d-block">Giá 1 đêm (chưa gồm thuế/phí)</small>
                                        <span class="fs-4 fw-extrabold text-primary">@room.PricePerNight.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Room" asp-action="Detail" asp-route-id="@room.Id" asp-route-checkIn="@Model.CheckInDate.ToString("yyyy-MM-dd")" asp-route-checkOut="@Model.CheckOutDate.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold">
                                            Chi Tiết Phòng
                                        </a>
                                        <a asp-controller="Booking" asp-action="Checkout" asp-route-hotelId="@Model.Hotel.Id" asp-route-roomId="@room.Id" asp-route-checkIn="@Model.CheckInDate.ToString("yyyy-MM-dd")" asp-route-checkOut="@Model.CheckOutDate.ToString("yyyy-MM-dd")" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                                            Chọn Đặt Phòng Này <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Customer Reviews Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold text-dark mb-0"><i class="bi bi-chat-heart text-danger me-2"></i> Đánh Giá Từ Khách Đã Ở (@Model.Reviews.Count)</h4>
        </div>

        <div class="row g-4 mb-4">
            @if (Model.Reviews.Any())
            {
                @foreach (var rev in Model.Reviews)
                {
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 bg-light h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @rev.CustomerName.Substring(0, 1)
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">@rev.CustomerName</h6>
                                        <small class="text-muted">@rev.CreatedAt.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                                <div class="star-rating">
                                    @for (int i = 0; i < rev.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                </div>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@rev.Title</h6>
                            <p class="text-muted small mb-0">@rev.Comment</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Chưa có đánh giá nào cho khách sạn này. Hãy là người đầu tiên đánh giá!</p>
            }
        </div>

        <!-- Add Review Form -->
        <div class="pt-4 border-top">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i> Viết Đánh Giá Của Bạn</h5>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-action="AddReview" method="post">
                    <input type="hidden" name="hotelId" value="@Model.Hotel.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">ĐÁNH GIÁ SỐ SAO</label>
                            <select name="rating" class="form-select bg-light rounded-3">
                                <option value="5" selected>⭐⭐⭐⭐⭐ (5 Sao - Xuất sắc)</option>
                                <option value="4">⭐⭐⭐⭐ (4 Sao - Rất tốt)</option>
                                <option value="3">⭐⭐⭐ (3 Sao - Tốt)</option>
                                <option value="2">⭐⭐ (2 Sao - Tạm được)</option>
                                <option value="1">⭐ (1 Sao - Kém)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-muted">TIÊU ĐỀ ĐÁNH GIÁ</label>
                            <input type="text" name="title" class="form-control bg-light rounded-3" placeholder="Tóm tắt cảm nhận của bạn..." required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">NỘI DUNG ĐÁNH GIÁ CHI TIẾT</label>
                            <textarea name="comment" rows="3" class="form-control bg-light rounded-3" placeholder="Chia sẻ thêm về không gian phòng, phục vụ, bữa sáng..." required></textarea>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-1"></i> Gửi Đánh Giá
                            </button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="p-3 bg-light rounded-3 text-center">
                    <p class="mb-2 text-muted">Vui lòng đăng nhập để gửi đánh giá và nhận xét của bạn.</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                        Đăng Nhập Ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFav(hotelId) {
            fetch('/Hotel/ToggleFavorite', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `hotelId=${hotelId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const icon = document.getElementById('favIcon');
                    const text = document.getElementById('favText');
                    if (data.isFavorite) {
                        icon.className = 'bi bi-heart-fill text-danger';
                        text.innerText = 'Đã Lưu';
                    } else {
                        icon.className = 'bi bi-heart';
                        text.innerText = 'Lưu Yêu Thích';
                    }
                    alert(data.message);
                } else {
                    alert(data.message);
                    window.location.href = '/Account/Login';
                }
            })
            .catch(() => {
                alert('Vui lòng đăng nhập để sử dụng tính năng này.');
            });
        }
    </script>
}
