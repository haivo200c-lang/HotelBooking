@model HotelBooking.Models.ViewModels.HotelSearchFilterViewModel
@{
    ViewData["Title"] = "Danh Sách Khách Sạn & Khu Nghỉ Dưỡng";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Danh sách khách sạn</li>
        </ol>
    </nav>

    <!-- Top Summary Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white p-3 p-md-4 rounded-4 shadow-sm mb-4 border">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                @(string.IsNullOrEmpty(Model.City) ? (string.IsNullOrEmpty(Model.Destination) ? "Tất Cả Khách Sạn" : $"Kết quả tìm kiếm: \"{Model.Destination}\"") : $"Khách Sạn Tại {Model.City}")
            </h3>
            <p class="text-muted small mb-0">Tìm thấy <strong>@Model.TotalHotels</strong> khách sạn & khu nghỉ dưỡng phù hợp với tiêu chí của bạn</p>
        </div>
        
        <!-- Sorting Form -->
        <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
            <label class="small fw-bold text-muted text-nowrap">Sắp xếp theo:</label>
            <select class="form-select form-select-sm rounded-3 py-2 fw-semibold" style="width: auto;" onchange="updateSort(this.value)">
                <option value="featured" selected="@(Model.SortBy == "featured")">Nổi Bật Nhất</option>
                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Giá: Thấp đến Cao</option>
                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Giá: Cao đến Thấp</option>
                <option value="rating_desc" selected="@(Model.SortBy == "rating_desc")">Điểm Đánh Giá Cao Nhất</option>
            </select>
        </div>
    </div>

    <div class="row g-4">
        <!-- Filter Sidebar Column -->
        <div class="col-lg-3 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 85px; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel-fill text-primary me-1"></i> Bộ Lọc Tìm Kiếm</h5>
                    <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none p-0 text-danger small">Đặt lại</a>
                </div>

                <form id="filterForm" asp-action="Index" method="get">
                    <input type="hidden" name="SortBy" id="sortByInput" value="@Model.SortBy" />

                    <!-- Destination Input -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">ĐIỂM ĐẾN / TÊN KHÁCH SẠN</label>
                        <input type="text" name="Destination" class="form-control bg-light py-2 rounded-3 small" placeholder="Nhập tên thành phố..." value="@Model.Destination" />
                    </div>

                    <!-- City Select -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">THÀNH PHỐ</label>
                        <select name="City" class="form-select bg-light py-2 rounded-3 small">
                            <option value="">-- Tất cả thành phố --</option>
                            @foreach (var city in Model.AvailableCities)
                            {
                                <option value="@city" selected="@(Model.City == city)">@city</option>
                            }
                        </select>
                    </div>

                    <!-- Star Rating Filter -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">HẠNG SAO</label>
                        <div class="d-flex flex-column gap-1">
                            @for (int stars = 5; stars >= 3; stars--)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="StarRating" value="@stars" id="star_@stars" @(Model.StarRating == stars ? "checked" : "") />
                                    <label class="form-check-label small" for="star_@stars">
                                        <span class="text-warning">
                                            @for (int s = 0; s < stars; s++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </span> (@stars Sao)
                                    </label>
                                </div>
                            }
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="StarRating" value="" id="star_all" @(!Model.StarRating.HasValue ? "checked" : "") />
                                <label class="form-check-label small text-muted" for="star_all">Tất cả hạng sao</label>
                            </div>
                        </div>
                    </div>

                    <!-- Price Filter -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">KHOẢNG GIÁ (VNĐ / ĐÊM)</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="MinPrice" class="form-control bg-light rounded-3 small p-2" placeholder="Tối thiểu" value="@Model.MinPrice" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="MaxPrice" class="form-control bg-light rounded-3 small p-2" placeholder="Tối đa" value="@Model.MaxPrice" />
                            </div>
                        </div>
                    </div>

                    <!-- Review Rating Filter -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">ĐIỂM ĐÁNH GIÁ</label>
                        <select name="MinRating" class="form-select bg-light py-2 rounded-3 small">
                            <option value="">-- Tất cả đánh giá --</option>
                            <option value="9.0" selected="@(Model.MinRating == 9.0)">9.0+ Tuyệt Hảo</option>
                            <option value="8.0" selected="@(Model.MinRating == 8.0)">8.0+ Rất Tốt</option>
                            <option value="7.0" selected="@(Model.MinRating == 7.0)">7.0+ Tốt</option>
                        </select>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary rounded-3 fw-bold py-2 shadow-sm">
                            <i class="bi bi-funnel me-1"></i> Áp Dụng Bộ Lọc
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Hotel List Grid Column -->
        <div class="col-lg-9 col-md-8">
            @if (Model.Hotels.Any())
            {
                <div class="row g-4">
                    @foreach (var hotel in Model.Hotels)
                    {
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden hotel-card">
                                <div class="row g-0">
                                    <div class="col-lg-4 col-md-5 position-relative">
                                        <img src="@hotel.MainImageUrl" class="h-100 w-100" style="object-fit: cover; min-height: 240px;" alt="@hotel.Name" loading="lazy" />
                                        @if (hotel.IsFeatured)
                                        {
                                            <span class="badge-featured"><i class="bi bi-stars me-1"></i> Nổi Bật</span>
                                        }
                                    </div>
                                    <div class="col-lg-8 col-md-7 p-4 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="star-rating mb-1">
                                                    @for (int i = 0; i < hotel.StarRating; i++)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                </div>
                                                <h5 class="fw-bold text-dark mb-1">
                                                    <a asp-action="Detail" asp-route-id="@hotel.Id" class="text-dark text-decoration-none">
                                                        @hotel.Name
                                                    </a>
                                                </h5>
                                                <p class="text-muted small mb-2">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @hotel.Address, <strong>@hotel.City</strong>
                                                </p>
                                            </div>

                                            <div class="text-end">
                                                <span class="badge-rating">@hotel.AverageRating</span>
                                                <small class="d-block text-muted mt-1" style="font-size: 0.75rem;">@hotel.TotalReviewCount đánh giá</small>
                                            </div>
                                        </div>

                                        <p class="text-muted small mb-3 text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                            @hotel.Description
                                        </p>

                                        <!-- Facilities -->
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @foreach (var ha in hotel.HotelAmenities.Take(4))
                                            {
                                                <span class="facility-pill">
                                                    <i class="bi @ha.Amenity?.Icon text-primary"></i> @ha.Amenity?.Name
                                                </span>
                                            }
                                        </div>

                                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                            <div>
                                                <small class="text-muted d-block">Giá chỉ từ</small>
                                                <span class="fs-5 fw-extrabold text-primary">@hotel.MinPrice.ToString("N0") đ</span>
                                                <small class="text-muted"> / đêm</small>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a asp-action="Detail" asp-route-id="@hotel.Id" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                                                    Xem Chi Tiết
                                                </a>
                                                <a asp-action="Detail" asp-route-id="@hotel.Id" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                                                    Đặt Phòng Ngay <i class="bi bi-arrow-right ms-1"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-center mt-5">
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                @for (int p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.Page ? "active" : "")">
                                        <a class="page-link rounded-3 mx-1" href="@Url.Action("Index", new { Page = p, City = Model.City, Destination = Model.Destination, StarRating = Model.StarRating, MinPrice = Model.MinPrice, MaxPrice = Model.MaxPrice, MinRating = Model.MinRating, SortBy = Model.SortBy })">@p</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                    <div class="mb-3 text-muted">
                        <i class="bi bi-search display-1 text-primary opacity-50"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Không Tìm Thấy Khách Sạn Phù Hợp</h4>
                    <p class="text-muted">Vui lòng thử điều chỉnh lại bộ lọc hoặc tìm kiếm theo thành phố khác.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                            Xem Toàn Bộ Khách Sạn
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateSort(sortValue) {
            document.getElementById('sortByInput').value = sortValue;
            document.getElementById('filterForm').submit();
        }
    </script>
}
