@model HotelBooking.Models.Entities.Booking
@{
    ViewData["Title"] = "Quản Lý Đơn - " + Model.BookingCode;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Chi Tiết Đơn Đặt Phòng: <span class="font-monospace text-primary">@Model.BookingCode</span></h4>
        <p class="text-muted small mb-0">Thời gian tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Quay Lại
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Main Booking Details (Left) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person text-primary me-2"></i> Thông Tin Khách Hàng & Liên Hệ</h5>
            <div class="row g-3 small">
                <div class="col-md-6">
                    <span class="text-muted d-block">Họ và tên khách:</span>
                    <strong class="text-dark fs-6">@Model.CustomerName</strong>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block">Số điện thoại:</span>
                    <strong class="text-dark fs-6"><i class="bi bi-telephone text-success me-1"></i> @Model.CustomerPhone</strong>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block">Email liên hệ:</span>
                    <strong class="text-dark">@Model.CustomerEmail</strong>
                </div>
                <div class="col-md-6">
                    <span class="text-muted d-block">Địa chỉ:</span>
                    <strong class="text-dark">@(Model.CustomerAddress ?? "Không cung cấp")</strong>
                </div>
                <div class="col-12">
                    <span class="text-muted d-block">Ghi chú đặc biệt từ khách:</span>
                    <div class="p-2 bg-light rounded-3 mt-1">
                        <em>@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có yêu cầu đặc biệt" : Model.Notes)</em>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-door-open text-primary me-2"></i> Hạng Phòng & Bảng Giá</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Hạng Phòng</th>
                            <th class="text-center">Số Phòng</th>
                            <th class="text-center">Số Đêm</th>
                            <th class="text-end">Đơn Giá / Đêm</th>
                            <th class="text-end pe-4">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.BookingDetails)
                        {
                            <tr>
                                <td class="ps-4"><strong>@detail.RoomName</strong></td>
                                <td class="text-center">@detail.Quantity</td>
                                <td class="text-center">@detail.Nights</td>
                                <td class="text-end">@detail.PricePerNight.ToString("N0") đ</td>
                                <td class="text-end pe-4 fw-bold text-dark">@detail.SubTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Booking Status Action Card (Right) -->
    <div class="col-lg-4">
        <!-- Update Status Box -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gear text-primary me-2"></i> Trạng Thái Nghiệp Vụ</h5>

            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">CHUYỂN TRẠNG THÁI</label>
                    <select name="newStatus" class="form-select bg-light py-2 rounded-3 fw-bold text-primary">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Chờ Duyệt (Pending)</option>
                        <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Đã Xác Nhận (Confirmed)</option>
                        <option value="CheckedIn" selected="@(Model.Status == "CheckedIn")">Đang Lưu Trú (CheckedIn)</option>
                        <option value="CheckedOut" selected="@(Model.Status == "CheckedOut")">Đã Trả Phòng (CheckedOut)</option>
                        <option value="Completed" selected="@(Model.Status == "Completed")">Hoàn Tất Đơn (Completed)</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Hủy Đơn (Cancelled)</option>
                    </select>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold py-2 shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Lưu Cập Nhật
                    </button>
                </div>
            </form>
        </div>

        <!-- Financial Summary Box -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-primary me-2"></i> Tổng Hợp Chi Phí</h5>
            <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Tiền phòng:</span>
                <strong class="text-dark">@Model.SubTotal.ToString("N0") đ</strong>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Thuế GTGT (8%):</span>
                <span>@Model.TaxAmount.ToString("N0") đ</span>
            </div>
            <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Phí dịch vụ (5%):</span>
                <span>@Model.ServiceFee.ToString("N0") đ</span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between fs-5 fw-bold text-dark mb-3">
                <span>Tổng tiền:</span>
                <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span>
            </div>

            <div class="p-3 bg-light rounded-3 small">
                <span class="text-muted d-block mb-1">Phương thức thanh toán:</span>
                @if (Model.Payment != null)
                {
                    <strong class="text-dark d-block">@Model.Payment.PaymentMethod (@Model.Payment.Status)</strong>
                    <small class="text-muted font-monospace">Mã GD: @Model.Payment.TransactionRef</small>
                }
                else
                {
                    <strong class="text-warning">Chờ thanh toán tại quầy</strong>
                }
            </div>
        </div>
    </div>
</div>
