@model List<HotelBooking.Models.Entities.Booking>
@{
    ViewData["Title"] = "Quản Lý Đơn Đặt Phòng";
    var currentStatus = ViewData["CurrentStatus"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Quản Lý Đơn Đặt Phòng Toàn Hệ Thống</h4>
        <p class="text-muted small mb-0">Theo dõi, duyệt đơn, check-in, check-out và quản lý trạng thái lưu trú</p>
    </div>
</div>

<!-- Status Filter Tabs -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-light") rounded-pill px-3 fw-bold">
            Tất Cả (@Model.Count)
        </a>
        <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning text-dark" : "btn-light") rounded-pill px-3 fw-bold">
            Chờ Duyệt
        </a>
        <a asp-action="Index" asp-route-status="Confirmed" class="btn btn-sm @(currentStatus == "Confirmed" ? "btn-success" : "btn-light") rounded-pill px-3 fw-bold">
            Đã Xác Nhận
        </a>
        <a asp-action="Index" asp-route-status="CheckedIn" class="btn btn-sm @(currentStatus == "CheckedIn" ? "btn-primary" : "btn-light") rounded-pill px-3 fw-bold">
            Đang Lưu Trú
        </a>
        <a asp-action="Index" asp-route-status="CheckedOut" class="btn btn-sm @(currentStatus == "CheckedOut" ? "btn-info text-dark" : "btn-light") rounded-pill px-3 fw-bold">
            Đã Trả Phòng
        </a>
        <a asp-action="Index" asp-route-status="Completed" class="btn btn-sm @(currentStatus == "Completed" ? "btn-secondary" : "btn-light") rounded-pill px-3 fw-bold">
            Hoàn Tất
        </a>
        <a asp-action="Index" asp-route-status="Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-danger" : "btn-light") rounded-pill px-3 fw-bold">
            Đã Hủy
        </a>
    </div>

    <!-- Search input -->
    <form method="get" class="row g-2">
        <input type="hidden" name="status" value="@currentStatus" />
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Tìm theo Mã đơn (HB-...), Tên khách hàng hoặc Số điện thoại..." value="@ViewData["CurrentSearch"]" />
            </div>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary rounded-3 fw-semibold">Tìm Kiếm</button>
        </div>
    </form>
</div>

<!-- Bookings Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4">Mã Đơn & Ngày Tạo</th>
                    <th>Khách Hàng</th>
                    <th>Khách Sạn & Phòng</th>
                    <th>Ngày Nhận / Trả</th>
                    <th>Tổng Tiền</th>
                    <th>Thanh Toán</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Cập Nhật Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <a asp-action="Details" asp-route-id="@b.Id" class="fw-bold font-monospace text-primary text-decoration-none">
                                @b.BookingCode
                            </a>
                            <small class="d-block text-muted" style="font-size: 0.75rem;">@b.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td>
                            <strong class="text-dark d-block">@b.CustomerName</strong>
                            <small class="text-muted"><i class="bi bi-telephone me-1"></i> @b.CustomerPhone</small>
                        </td>
                        <td>
                            <strong class="text-dark d-block text-truncate" style="max-width: 180px;">@b.Hotel?.Name</strong>
                            <small class="text-muted">@b.BookingDetails.FirstOrDefault()?.RoomName (@b.TotalRooms phòng)</small>
                        </td>
                        <td>
                            <small class="d-block text-muted">@b.CheckInDate.ToString("dd/MM") - @b.CheckOutDate.ToString("dd/MM/yy")</small>
                            <span class="badge bg-light text-dark border">@b.TotalNights đêm</span>
                        </td>
                        <td>
                            <strong class="text-danger fw-bold">@b.TotalAmount.ToString("N0") đ</strong>
                        </td>
                        <td>
                            @if (b.Payment?.Status == "Completed")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">
                                    <i class="bi bi-check-circle"></i> Đã Thu (@b.Payment.PaymentMethod)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 rounded-pill">
                                    <i class="bi bi-clock"></i> Chưa Thu
                                </span>
                            }
                        </td>
                        <td>
                            @switch (b.Status)
                            {
                                case "Confirmed":
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Đã Xác Nhận</span>
                                    break;
                                case "Pending":
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chờ Duyệt</span>
                                    break;
                                case "CheckedIn":
                                    <span class="badge bg-primary px-3 py-1 rounded-pill">Đang Ở</span>
                                    break;
                                case "CheckedOut":
                                    <span class="badge bg-info text-dark px-3 py-1 rounded-pill">Đã Trả Phòng</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Hoàn Tất</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger px-3 py-1 rounded-pill">Đã Hủy</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <!-- Quick Status Switch Dropdown Form -->
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@b.Id" />
                                    <select name="newStatus" class="form-select form-select-sm rounded-pill py-1 small fw-semibold" style="width: auto;" onchange="this.form.submit()">
                                        <option value="Pending" selected="@(b.Status == "Pending")">Chờ Duyệt</option>
                                        <option value="Confirmed" selected="@(b.Status == "Confirmed")">Duyệt Đơn (Confirm)</option>
                                        <option value="CheckedIn" selected="@(b.Status == "CheckedIn")">Nhận Phòng (CheckIn)</option>
                                        <option value="CheckedOut" selected="@(b.Status == "CheckedOut")">Trả Phòng (CheckOut)</option>
                                        <option value="Completed" selected="@(b.Status == "Completed")">Hoàn Tất (Complete)</option>
                                        <option value="Cancelled" selected="@(b.Status == "Cancelled")">Hủy Đơn (Cancel)</option>
                                    </select>
                                </form>

                                <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-primary btn-sm rounded-pill px-2" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
