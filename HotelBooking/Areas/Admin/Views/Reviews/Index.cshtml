@model List<HotelBooking.Models.Entities.Review>
@{
    ViewData["Title"] = "Quản Lý Đánh Giá & Nhận Xét";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Kiểm Duyệt Đánh Giá Khách Hàng</h4>
        <p class="text-muted small mb-0">Quản lý, duyệt và kiểm duyệt nhận xét từ khách hàng sau khi lưu trú</p>
    </div>
    <div class="bg-white p-2 px-3 rounded-4 shadow-sm border">
        <span class="small text-muted">Tổng số đánh giá:</span>
        <strong class="text-primary fs-5 ms-1">@Model.Count</strong>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4">Khách Sạn</th>
                    <th>Khách Hàng</th>
                    <th>Số Sao & Tiêu Đề</th>
                    <th>Nội Dung Nhận Xét</th>
                    <th>Ngày Đăng</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rev in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <strong class="text-dark d-block text-truncate" style="max-width: 180px;">@rev.Hotel?.Name</strong>
                            <small class="text-muted">@rev.Hotel?.City</small>
                        </td>
                        <td>
                            <strong class="text-dark d-block">@rev.CustomerName</strong>
                        </td>
                        <td>
                            <div class="star-rating mb-1">
                                @for (int i = 0; i < rev.Rating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                            </div>
                            <strong class="text-dark small d-block">@rev.Title</strong>
                        </td>
                        <td>
                            <p class="text-muted small mb-0 text-truncate-2" style="max-width: 320px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                "@rev.Comment"
                            </p>
                        </td>
                        <td>
                            <small class="text-muted">@rev.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            @if (rev.Status == "Approved")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill fw-bold">
                                    <i class="bi bi-check-circle me-1"></i> Đã Duyệt
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1 rounded-pill fw-bold">
                                    <i class="bi bi-eye-slash me-1"></i> Đã Ẩn
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-1">
                                @if (rev.Status != "Approved")
                                {
                                    <form asp-action="Approve" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@rev.Id" />
                                        <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3" title="Duyệt hiển thị">
                                            <i class="bi bi-check-lg"></i> Duyệt
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Hide" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@rev.Id" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3 text-dark" title="Ẩn đánh giá">
                                            <i class="bi bi-eye-slash"></i> Ẩn
                                        </button>
                                    </form>
                                }

                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đánh giá này không?');">
                                    <input type="hidden" name="id" value="@rev.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
