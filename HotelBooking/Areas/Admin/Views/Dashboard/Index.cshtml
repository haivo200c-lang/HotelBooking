@model HotelBooking.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Tổng Quan Quản Trị";
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Total Revenue -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">TỔNG DOANH THU</span>
                    <h3 class="fw-extrabold text-primary mb-0 mt-1">@Model.TotalRevenue.ToString("N0") đ</h3>
                    <small class="text-success"><i class="bi bi-arrow-up-right"></i> +18.4% so với tháng trước</small>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-cash-coin fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Bookings -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">TỔNG ĐƠN ĐẶT</span>
                    <h3 class="fw-extrabold text-success mb-0 mt-1">@Model.TotalBookings</h3>
                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> @Model.CompletedBookingsCount đơn hoàn tất</small>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-calendar2-check-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Hotels & Rooms -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">KHÁCH SẠN / PHÒNG</span>
                    <h3 class="fw-extrabold text-warning mb-0 mt-1">@Model.TotalHotels / @Model.TotalRooms</h3>
                    <small class="text-muted">Đang hoạt động toàn quốc</small>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-buildings-fill fs-3 text-dark"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Users -->
    <div class="col-xl-3 col-md-6">
        <div class="stat-card border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-bold text-uppercase">NGƯỜI DÙNG</span>
                    <h3 class="fw-extrabold text-info mb-0 mt-1">@Model.TotalUsers</h3>
                    <small class="text-danger fw-bold"><i class="bi bi-bell-fill"></i> @Model.PendingBookingsCount đơn chờ duyệt</small>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Revenue Monthly Bar Chart -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up text-primary me-2"></i> Doanh Thu Theo Tháng (VNĐ)</h5>
                <span class="badge bg-light text-muted border">Năm 2026</span>
            </div>
            <div style="height: 300px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Booking Status Doughnut Chart -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart-fill text-warning me-2"></i> Tỷ Lệ Trạng Thái Đơn</h5>
            <div style="height: 280px; position: relative;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Bookings Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-primary me-2"></i> Đơn Đặt Phòng Gần Đây Nhất</h5>
        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
            Xem Tất Cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4">Mã Đơn</th>
                    <th>Khách Hàng</th>
                    <th>Khách Sạn</th>
                    <th>Thời Gian</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.RecentBookings)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold font-monospace text-primary">@b.BookingCode</span>
                            <small class="d-block text-muted" style="font-size: 0.75rem;">@b.CreatedAt.ToString("dd/MM HH:mm")</small>
                        </td>
                        <td>
                            <strong class="text-dark d-block">@b.CustomerName</strong>
                            <small class="text-muted">@b.CustomerPhone</small>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 200px;">@b.Hotel?.Name</span>
                        </td>
                        <td>
                            <small class="d-block text-muted">@b.CheckInDate.ToString("dd/MM") - @b.CheckOutDate.ToString("dd/MM/yyyy")</small>
                            <span class="badge bg-light text-dark border">@b.TotalNights đêm</span>
                        </td>
                        <td>
                            <strong class="text-danger">@b.TotalAmount.ToString("N0") đ</strong>
                        </td>
                        <td>
                            @switch (b.Status)
                            {
                                case "Confirmed":
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Đã Xác Nhận</span>
                                    break;
                                case "Pending":
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chờ Duyệt</span>
                                    break;
                                case "CheckedIn":
                                    <span class="badge bg-primary px-3 py-1 rounded-pill">Đang Ở</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Hoàn Tất</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger px-3 py-1 rounded-pill">Đã Hủy</span>
                                    break;
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-area="Admin" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Monthly Revenue Chart
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months)),
                datasets: [{
                    label: 'Doanh Thu (VNĐ)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues)),
                    backgroundColor: 'rgba(59, 130, 246, 0.8)',
                    borderColor: '#2563eb',
                    borderWidth: 1,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return (value / 1000000) + ' Tr';
                            }
                        }
                    }
                }
            }
        });

        // 2. Status Doughnut Chart
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Keys)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatusDistribution.Values)),
                    backgroundColor: ['#10b981', '#f59e0b', '#3b82f6', '#64748b', '#ef4444'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '70%'
            }
        });
    </script>
}
