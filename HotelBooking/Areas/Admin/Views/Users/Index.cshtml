@model List<HotelBooking.Models.ViewModels.UserManagementViewModel>
@{
    ViewData["Title"] = "Quản Lý Người Dùng & Phân Quyền";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Quản Lý Tài Khoản & Phân Quyền</h4>
        <p class="text-muted small mb-0">Quản lý danh sách thành viên, khóa/mở khóa và gán vai trò hệ thống</p>
    </div>
</div>

<!-- Filter and Search -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" class="row g-2">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Tìm kiếm theo Tên hoặc Email..." value="@ViewData["CurrentSearch"]" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select bg-light">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin" selected="@(ViewData["CurrentRole"]?.ToString() == "Admin")">Admin</option>
                <option value="Staff" selected="@(ViewData["CurrentRole"]?.ToString() == "Staff")">Staff</option>
                <option value="Customer" selected="@(ViewData["CurrentRole"]?.ToString() == "Customer")">Customer</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary rounded-3 fw-semibold">Lọc</button>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4">Người Dùng</th>
                    <th>Số Điện Thoại & Địa Chỉ</th>
                    <th>Vai Trò (Role)</th>
                    <th>Lịch Sử Đặt</th>
                    <th>Ngày Tạo</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-4">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 40px; height: 40px;">
                                    @u.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <strong class="text-dark d-block">@u.FullName</strong>
                                    <small class="text-muted"><i class="bi bi-envelope me-1"></i> @u.Email</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="d-block small"><i class="bi bi-telephone me-1 text-success"></i> @(u.PhoneNumber ?? "Chưa có")</span>
                            <small class="text-muted text-truncate d-inline-block" style="max-width: 150px;">@(u.Address ?? "Việt Nam")</small>
                        </td>
                        <td>
                            @switch (u.Role)
                            {
                                case "Admin":
                                    <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="bi bi-shield-lock-fill me-1"></i> Admin</span>
                                    break;
                                case "Staff":
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="bi bi-person-workspace me-1"></i> Staff</span>
                                    break;
                                default:
                                    <span class="badge bg-primary px-3 py-1 rounded-pill"><i class="bi bi-person-check me-1"></i> Customer</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold">@u.TotalBookingsCount đơn</span>
                        </td>
                        <td>
                            <small class="text-muted">@u.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill fw-bold">Hoạt Động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill fw-bold">Đã Khóa</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-1">
                                <!-- Change Role Dropdown Form -->
                                <form asp-action="ChangeRole" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <select name="newRole" class="form-select form-select-sm rounded-pill py-1 small" style="width: auto;" onchange="this.form.submit()">
                                        <option value="Customer" selected="@(u.Role == "Customer")">Quyền Customer</option>
                                        <option value="Staff" selected="@(u.Role == "Staff")">Quyền Staff</option>
                                        <option value="Admin" selected="@(u.Role == "Admin")">Quyền Admin</option>
                                    </select>
                                </form>

                                <!-- Lock / Unlock Button -->
                                <form asp-action="ToggleLock" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Khóa tài khoản">
                                            <i class="bi bi-lock-fill"></i> Khóa
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3" title="Mở khóa tài khoản">
                                            <i class="bi bi-unlock-fill"></i> Mở
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
