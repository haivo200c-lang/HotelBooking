@using Microsoft.AspNetCore.Identity
@using HotelBooking.Models.Entities
@inject UserManager<AppUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal | Hotel Booking</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Admin Styling -->
    <style>
        :root {
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --primary-admin: #3b82f6;
            --font-family: 'Plus Jakarta Sans', sans-serif;
        }
        body {
            font-family: var(--font-family);
            background-color: #f1f5f9;
            color: #334155;
        }
        .admin-sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            min-height: 100vh;
            transition: all 0.3s;
            z-index: 1000;
        }
        .admin-sidebar .nav-link {
            color: #94a3b8;
            font-weight: 500;
            padding: 10px 16px;
            border-radius: 10px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
        }
        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
            color: #ffffff;
            background-color: var(--sidebar-hover);
        }
        .admin-sidebar .nav-link.active {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: 600;
        }
        .admin-content {
            flex-grow: 1;
            min-width: 0;
        }
        .admin-topbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
        }
        .stat-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            transition: transform 0.2s ease;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
    </style>
</head>
<body class="d-flex min-vh-100">
    @{
        var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentUser = await UserManager.GetUserAsync(User);
    }

    <!-- Sidebar -->
    <aside class="admin-sidebar d-flex flex-column flex-shrink-0 p-3 text-white">
        <!-- Logo -->
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center mb-4 px-2 text-white text-decoration-none">
            <div class="bg-primary text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                <i class="bi bi-buildings-fill"></i>
            </div>
            <div>
                <span class="fs-5 fw-extrabold tracking-tight">ADMIN</span><span class="text-primary fs-5 fw-extrabold">PANEL</span>
            </div>
        </a>

        <hr class="border-secondary opacity-25 my-2">

        <!-- Navigation Menu -->
        <ul class="nav nav-pills flex-column mb-auto mt-2">
            <li class="nav-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link @(activeController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2 fs-5"></i> Dashboard
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Hotels" asp-action="Index" class="nav-link @(activeController == "Hotels" ? "active" : "")">
                    <i class="bi bi-building fs-5"></i> Quản Lý Khách Sạn
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="nav-link @(activeController == "Rooms" ? "active" : "")">
                    <i class="bi bi-door-open fs-5"></i> Quản Lý Phòng
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="nav-link @(activeController == "Bookings" ? "active" : "")">
                    <i class="bi bi-calendar2-check fs-5"></i> Quản Lý Đơn Đặt
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="nav-link @(activeController == "Users" ? "active" : "")">
                    <i class="bi bi-people fs-5"></i> Quản Lý Người Dùng
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Payments" asp-action="Index" class="nav-link @(activeController == "Payments" ? "active" : "")">
                    <i class="bi bi-credit-card-2-front fs-5"></i> Quản Lý Giao Dịch
                </a>
            </li>
            <li>
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="nav-link @(activeController == "Reviews" ? "active" : "")">
                    <i class="bi bi-star-half fs-5"></i> Quản Lý Đánh Giá
                </a>
            </li>
        </ul>

        <hr class="border-secondary opacity-25">

        <!-- Bottom Links -->
        <div class="px-2">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm w-100 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-globe me-1"></i> Xem Trang Khách Hàng
            </a>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-danger btn-sm w-100 rounded-pill fw-semibold">
                <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
            </a>
        </div>
    </aside>

    <!-- Main Admin Container -->
    <div class="admin-content d-flex flex-column">
        <!-- Topbar -->
        <header class="admin-topbar d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center">
                <h5 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h5>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold">
                    <i class="bi bi-shield-lock-fill me-1"></i> @(User.IsInRole("Admin") ? "Admin Quyền Cao Nhất" : "Nhân Viên Staff")
                </span>

                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                        @(currentUser?.FullName?.Substring(0, 1) ?? "A")
                    </div>
                    <span class="fw-semibold text-dark small d-none d-md-inline">@(currentUser?.FullName ?? "Admin")</span>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="p-4 flex-grow-1">
            <!-- Global Toast / Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
