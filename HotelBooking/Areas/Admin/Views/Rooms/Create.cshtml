@model HotelBooking.Models.Entities.Room
@{
    ViewData["Title"] = "Thêm Hạng Phòng Mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Thêm Hạng Phòng Mới</h4>
        <p class="text-muted small mb-0">Cấu hình thông số kỹ thuật, giá niêm yết và số lượng phòng</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Quay Lại
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="HotelId" class="form-label fw-bold small text-muted">CHỌN KHÁCH SẠN <span class="text-danger">*</span></label>
                <select asp-for="HotelId" class="form-select bg-light py-2 rounded-3" asp-items="ViewBag.HotelId" required></select>
            </div>

            <div class="col-md-6">
                <label asp-for="RoomTypeId" class="form-label fw-bold small text-muted">LOẠI PHÒNG <span class="text-danger">*</span></label>
                <select asp-for="RoomTypeId" class="form-select bg-light py-2 rounded-3" asp-items="ViewBag.RoomTypeId" required></select>
            </div>

            <div class="col-md-8">
                <label asp-for="Name" class="form-label fw-bold small text-muted">TÊN HẠNG PHÒNG <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control bg-light py-2 rounded-3" placeholder="Ví dụ: Deluxe Ocean View" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="RoomNumber" class="form-label fw-bold small text-muted">MÃ / SỐ PHÒNG</label>
                <input asp-for="RoomNumber" class="form-control bg-light py-2 rounded-3" placeholder="VD: DLX-101" />
            </div>

            <div class="col-md-4">
                <label asp-for="PricePerNight" class="form-label fw-bold small text-muted">GIÁ 1 ĐÊM (VNĐ) <span class="text-danger">*</span></label>
                <input asp-for="PricePerNight" type="number" class="form-control bg-light py-2 rounded-3" placeholder="3500000" required />
                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Capacity" class="form-label fw-bold small text-muted">SỨC CHỨA TỐI ĐA (NGƯỜI)</label>
                <input asp-for="Capacity" type="number" class="form-control bg-light py-2 rounded-3" value="2" min="1" max="10" required />
            </div>

            <div class="col-md-4">
                <label asp-for="AreaM2" class="form-label fw-bold small text-muted">DIỆN TÍCH (M²)</label>
                <input asp-for="AreaM2" type="number" step="0.5" class="form-control bg-light py-2 rounded-3" value="45.0" required />
            </div>

            <div class="col-md-6">
                <label asp-for="BedInfo" class="form-label fw-bold small text-muted">KIỂU GIƯỜNG</label>
                <input asp-for="BedInfo" class="form-control bg-light py-2 rounded-3" placeholder="1 Giường King hoặc 2 Giường đơn" required />
            </div>

            <div class="col-md-6">
                <label asp-for="TotalQuantity" class="form-label fw-bold small text-muted">TỔNG SỐ LƯỢNG PHÒNG NÀY</label>
                <input asp-for="TotalQuantity" type="number" class="form-control bg-light py-2 rounded-3" value="10" min="1" required />
            </div>

            <div class="col-12">
                <label asp-for="ImageUrl" class="form-label fw-bold small text-muted">LINK HÌNH ẢNH PHÒNG (URL) <span class="text-danger">*</span></label>
                <input asp-for="ImageUrl" class="form-control bg-light py-2 rounded-3" placeholder="https://images.unsplash.com/..." required />
                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-bold small text-muted">MÔ TẢ CHI TIẾT PHÒNG</label>
                <textarea asp-for="Description" rows="3" class="form-control bg-light rounded-3" placeholder="Mô tả tầm nhìn, ban công, tiện ích riêng của phòng..."></textarea>
            </div>

            <div class="col-12">
                <div class="form-check form-switch mt-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" checked />
                    <label class="form-check-label fw-semibold" for="isActiveCheck">Đang Mở Cho Thuê (Hoạt động)</label>
                </div>
            </div>
        </div>

        <div class="text-end pt-3 border-top">
            <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm">
                <i class="bi bi-check-circle me-1"></i> Lưu Hạng Phòng
            </button>
        </div>
    </form>
</div>
