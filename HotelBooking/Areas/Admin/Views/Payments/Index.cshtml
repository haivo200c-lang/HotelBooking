@model List<HotelBooking.Models.Entities.Payment>
@{
    ViewData["Title"] = "Quản Lý Giao Dịch Thanh Toán";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Nhật Ký Giao Dịch Thanh Toán</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ các giao dịch qua cổng VNPay, MoMo, VietQR và tiền mặt</p>
    </div>
    <div class="bg-white p-2 px-3 rounded-4 shadow-sm border">
        <span class="small text-muted">Tổng số giao dịch:</span>
        <strong class="text-primary fs-5 ms-1">@Model.Count</strong>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th class="ps-4">Mã Thanh Toán</th>
                    <th>Mã Đơn Đặt</th>
                    <th>Khách Sạn</th>
                    <th>Số Tiền</th>
                    <th>Phương Thức</th>
                    <th>Mã Giao Dịch Ref</th>
                    <th>Ngày Thanh Toán</th>
                    <th class="text-end pe-4">Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-bold font-monospace text-dark">@p.PaymentCode</span>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="Bookings" asp-action="Details" asp-route-id="@p.BookingId" class="fw-bold font-monospace text-primary text-decoration-none">
                                @p.Booking?.BookingCode
                            </a>
                        </td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 180px;">@p.Booking?.Hotel?.Name</span>
                        </td>
                        <td>
                            <strong class="text-danger">@p.Amount.ToString("N0") đ</strong>
                        </td>
                        <td>
                            @switch (p.PaymentMethod)
                            {
                                case "VNPay":
                                    <span class="badge bg-danger">VNPay</span>
                                    break;
                                case "MoMo":
                                    <span class="badge" style="background-color: #a50064; color: white;">MoMo</span>
                                    break;
                                case "BankTransfer":
                                    <span class="badge bg-success">VietQR</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Tiền mặt</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="font-monospace text-muted small">@(p.TransactionRef ?? "N/A")</span>
                        </td>
                        <td>
                            <small class="text-muted">@(p.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? p.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</small>
                        </td>
                        <td class="text-end pe-4">
                            @if (p.Status == "Completed")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">
                                    <i class="bi bi-check-circle me-1"></i> Thành Công
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 fw-bold">
                                    <i class="bi bi-clock me-1"></i> Đang Xử Lý
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
